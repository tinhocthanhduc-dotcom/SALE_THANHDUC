{
  "manifest_version": 3,
  "name": "Thành Đức · Thử đọc Zalo",
  "version": "0.11.0",
  "description": "Đọc hai nhóm kho, lưu trên máy; tùy chọn tự lưu sang Google Sheets riêng. Chưa ghi kho.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.zalo.me/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thành Đức · Thử đọc Zalo"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.zalo.me/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
